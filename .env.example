# Shared environment for every app (backend, CLI, mobile).
# Copy to .env at the repo root:  cp .env.example .env
#
# - Go apps (apps/back, apps/cli) load the nearest .env automatically at
#   startup (libs/env). A real shell `export` still overrides the file.
# - Mobile reads it through apps/mobile/.env, a symlink to this file. Expo
#   inlines EXPO_PUBLIC_* at bundle time, so restart `expo start` after edits.

# --- Backend / CLI (Postgres + Memgraph match docker-compose.yml) ---
# NEO4J_* vars name the Bolt driver (neo4j-go-driver), which also drives Memgraph.
# HTTP_ADDR=:8080
POSTGRES_DSN=postgres://saecula:saecula_dev_password@localhost:5432/saecula?sslmode=disable
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=saecula_dev_password
# Set a strong value in production (required when APP_ENV=production).
JWT_SECRET=saecula-insecure-dev-secret-change-me

# --- AI chat "Ask" (Gemini via Genkit) ---
# Chat is disabled (503) until this is set.
GEMINI_API_KEY=
# CHAT_MODEL=googleai/gemini-flash-latest
# CHAT_MAX_TOOL_ITERS=5
# CHAT_MAX_OUTPUT_TOKENS=1024
# CHAT_RATE_PER_MIN=20

# --- Mobile (Expo) ---
# Backend base URL as seen from the device:
#   web / iOS simulator: http://localhost:8080
#   Android emulator:    http://10.0.2.2:8080
#   physical device:     your machine's LAN IP, e.g. http://192.168.1.9:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
