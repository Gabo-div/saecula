# Copy to .env and adjust. Expo inlines EXPO_PUBLIC_* at bundle time —
# restart `expo start` after changing it.
#
# localhost works for web and iOS simulator.
# Android emulator: http://10.0.2.2:8080
# Physical device (Expo Go): your machine's LAN IP, e.g. http://192.168.1.9:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
