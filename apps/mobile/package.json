{
  "name": "saecula-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "dev": "bun --bun x expo start",
    "start": "bun --bun x expo start",
    "android": "bun --bun x expo start --android",
    "ios": "bun --bun x expo start --ios",
    "web": "bun --bun x expo start --web",
    "prebuild": "bun --bun x expo prebuild --platform android",
    "build:dev:native": "bun --bun x expo run:android",
    "build:dev:native:release": "bun --bun x expo run:android --variant release",
    "build:dev": "bun x eas-cli build --platform android --profile development",
    "build:dev:local": "bun x eas-cli build --platform android --profile development --local",
    "build:preview": "bun x eas-cli build --platform android --profile preview",
    "build:prod": "bun x eas-cli build --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "maestro": "bash scripts/maestro.sh",
    "maestro:fast": "bash scripts/maestro.sh --no-build",
    "test:e2e": "bash scripts/maestro.sh",
    "test:e2e:full": "bash ../../scripts/e2e.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.18.3",
    "@saecula/contracts": "*",
    "@tamagui/config": "^2.0.0",
    "axios": "^1.7.9",
    "expo": "~54.0.0",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.7",
    "expo-localization": "~17.0.9",
    "expo-media-library": "~18.2.1",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "i18next": "^26.3.6",
    "markdown-it": "^15.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.10",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.5.1",
    "tamagui": "^2.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@saecula/config": "*",
    "@tamagui/babel-plugin": "^2.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "typescript": "~5.9.0"
  },
  "resolutions": {
    "@tamagui/core": "^2.0.0",
    "@tamagui/web": "^2.0.0",
    "tamagui": "^2.0.0"
  }
}
